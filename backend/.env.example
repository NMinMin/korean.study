NODE_ENV=development
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only. Never use this value in VITE_* variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used only by `npm run seed:admin`. Keep a strong password outside Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_DISPLAY_NAME=Quản trị viên

GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project
# Store the whole service-account JSON as a Render secret string.
GOOGLE_APPLICATION_CREDENTIALS_JSON={}

SMTP_FROM_EMAIL=no-reply@example.com
REMINDER_JOB_SECRET=replace-with-a-long-random-secret

# Cloudinary: API secret is server-only and must never use a VITE_ prefix.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
