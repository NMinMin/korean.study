NODE_ENV=development
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,https://nminmin.github.io,https://your-site.netlify.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only. Never use this value in VITE_* variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Used only by `npm run seed:admin`. Keep a strong password outside Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_DISPLAY_NAME=Quản trị viên

# Server-only. Create a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key
# Fast multilingual model; `whisper-large-v3` favors accuracy over speed.
GROQ_SPEECH_MODEL=whisper-large-v3-turbo

# Speech-to-text adapter used by Shadowing. The API receives multipart/form-data
# with one audio file in the `file` field and returns { "text": "..." }.
SPEECH_TO_TEXT_URL=https://speech-to-text-hy3k.onrender.com/transcribe

# Use a separate Groq account/key for text grading and AI-generated exercises.
GROQ_GRADER_API_KEY=gsk_your-separate-grader-api-key
GROQ_GRADER_MODEL=openai/gpt-oss-20b

SMTP_FROM_EMAIL=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
REMINDER_JOB_SECRET=replace-with-a-long-random-secret

# Cloudinary: API secret is server-only and must never use a VITE_ prefix.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
